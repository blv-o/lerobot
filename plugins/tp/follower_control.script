# ------------------------------------------------------------------
#  follower_control.script  (URScript, programa del TP)
#
#  Programa que corre en el UR follower. Se carga en el TP como nodo
#  Script de un programa y se le da a Play antes de cada sesion y tras
#  cada parada. El PC lo alimenta por RTDE:
#    input_double_register_0..5  <- consigna articular (rad)
#    input_int_register_0        <- enable (0/1)
#    input_int_register_1        <- contador del PC (cambia en cada escritura)
#    output_int_register_0       -> heartbeat (contador; solo ya armado)
#
#  Ajustes del movimiento (solo viven aqui):
#    DT_S             periodo de servoj (125 Hz)
#    TARGET_PERIOD_S  duracion de cada tramo (LeRobot con --fps=30)
#    MAX_SPEED_RAD_S  velocidad maxima por articulacion (60 grados/s)
#    LOOKAHEAD_S, GAIN  de servoj
#
#  Ciclo de vida: mantener la pose hasta enable=1, seguir la consigna
#  mientras enable=1 y, cuando vuelve a 0, stopj y fin. Sin watchdog:
#  si el PC deja de escribir, el robot se queda en la ultima consigna
#  y se para con Stop en el TP. No se re-arma: tras una parada se
#  vuelve a dar a Play.
# ------------------------------------------------------------------

DT_S = 0.008
TARGET_PERIOD_S = 0.033
MAX_SPEED_RAD_S = 1.0471975512
MAX_STEP_RAD = MAX_SPEED_RAD_S * DT_S
LOOKAHEAD_S = 0.1
GAIN = 300

textmsg("follower_control: esperando al PC")

# Mantener la pose leida UNA vez: releerla en cada ciclo la dejaria derivar.
q = get_actual_joint_positions()
hb = 0

# Esperar a que el PC escriba. Se espera un CAMBIO del contador, no un
# valor: los registros guardan el ultimo aunque el PC se desconecte.
# Y con enable=0 (la escritura de connect()): un enable=1 que ya estaba
# (proceso anterior, o Stop y Play con el PC en marcha) nunca mueve el robot.
# Sin heartbeat hasta armarse: connect() del PC vuelve al verlo latir.
v0 = read_input_integer_register(1)
while read_input_integer_register(1) == v0 or read_input_integer_register(0) != 0:
	servoj(q, 0, 0, DT_S, LOOKAHEAD_S, GAIN)
end

while read_input_integer_register(0) == 0:
	servoj(q, 0, 0, DT_S, LOOKAHEAD_S, GAIN)
	hb = hb + 1
	write_output_integer_register(0, hb)
end

textmsg("follower_control: habilitado")

# Cada cambio del contador es una consigna nueva: tramo lineal desde el
# ultimo comando (no desde la consigna anterior, asi no hay saltos) que
# dura TARGET_PERIOD_S, sin extrapolar. Al llegar se queda en ella.
cmd = [q[0], q[1], q[2], q[3], q[4], q[5]]
start = [q[0], q[1], q[2], q[3], q[4], q[5]]
target = [q[0], q[1], q[2], q[3], q[4], q[5]]
alpha = 1.0
seen = read_input_integer_register(1) - 1
while read_input_integer_register(0) == 1:
	c = read_input_integer_register(1)
	if c != seen:
		seen = c
		start = [cmd[0], cmd[1], cmd[2], cmd[3], cmd[4], cmd[5]]
		target = [read_input_float_register(0), read_input_float_register(1), read_input_float_register(2), read_input_float_register(3), read_input_float_register(4), read_input_float_register(5)]
		alpha = 0.0
	end
	alpha = alpha + DT_S / TARGET_PERIOD_S
	if alpha > 1.0:
		alpha = 1.0
	end
	# Paso recortado a la velocidad maxima en cada articulacion.
	i = 0
	while i < 6:
		step = start[i] + alpha * (target[i] - start[i]) - cmd[i]
		if step > MAX_STEP_RAD:
			step = MAX_STEP_RAD
		elif step < -MAX_STEP_RAD:
			step = -MAX_STEP_RAD
		end
		cmd[i] = cmd[i] + step
		i = i + 1
	end
	servoj(cmd, 0, 0, DT_S, LOOKAHEAD_S, GAIN)
	hb = hb + 1
	write_output_integer_register(0, hb)
end

# Deceleracion articular de la parada, en rad/s^2.
stopj(2.0)
textmsg("follower_control: parado")
